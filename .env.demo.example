DEMO_RUNTIME_ROOT=/home/gbibbo/asr_enhancement_runtime
DEMO_DB_PATH=
DEMO_UPLOAD_DIR=
DEMO_CACHE_DIR=
DEMO_ARTIFACTS_DIR=
DEMO_LOGS_DIR=
DEMO_WORKER_CONCURRENCY=1
DEMO_QUEUE_MAX=10
DEMO_UPLOAD_LIMIT_BYTES=5242880
DEMO_UPLOAD_MAX_DURATION_SECONDS=30
ASSEMBLYAI_API_KEY=
ENHANCER_VERSION=bypass
ADMIN_STATS_USERNAME=admin
ADMIN_STATS_PASSWORD=
WHISPER_MODEL_CACHE=

# B14.0/B14.2 recruiter HTTPBasic gate — SOLE authority for public /demo/* access.
# Set both on the host .env.demo before public exposure. With either empty the
# gate is fail-closed (every request gets 401). Never commit real values.
RECRUITER_USERNAME=
RECRUITER_PASSWORD=

# B14.1 public-exposure flag. Keep false for loopback/LAN. Set true on the RP5
# host only after the Tailscale Funnel tunnel is up. Does not relax the gate.
PUBLIC_DEMO_EXPOSURE=false

# Directory with the pre-built Next.js static export (out/). Served by the demo
# API behind the recruiter gate. Put it under the runtime root (bind-mounted at
# the same path in the container). Empty => no UI served.
DEMO_FRONTEND_DIR=/home/gbibbo/asr_enhancement_runtime/frontend

# B10.1 AssemblyAI cost-control overrides. Defaults match libs/common/demo_settings.py
# and infra/compose/docker-compose.demo.yml. Uncomment to override per-host.
# DEMO_ASSEMBLYAI_DAILY_SOFT_CAP_USD=5.0
# DEMO_ASSEMBLYAI_WARNING_CAP_USD=35.0
# DEMO_ASSEMBLYAI_HARD_CAP_USD=45.0
# DEMO_ASSEMBLYAI_USD_PER_SECOND=0.000103

# B12.1 lightweight observability. File logging is on by default in the demo
# Compose; library default is False. Filenames are
# ${DEMO_LOG_FILENAME_PREFIX}.${short_service}.log under ${DEMO_LOGS_DIR}
# (short_service strips the leading "demo-" so demo-api -> api,
# demo-worker -> worker => demo.api.log / demo.worker.log).
DEMO_LOG_TO_FILE=true
DEMO_LOG_MAX_BYTES=10485760
DEMO_LOG_BACKUP_COUNT=5
DEMO_LOG_FILENAME_PREFIX=demo
DEMO_ADMIN_RECENT_ERRORS=20

# B12.2 email alerts. Disabled by default. Set DEMO_ALERT_EMAIL_ENABLED=true and
# fill all five SMTP fields plus DEMO_ALERT_EMAIL_TO/FROM to enable real sends.
# Real credentials must NEVER be committed; keep them in the host's .env.demo.
DEMO_ALERT_EMAIL_ENABLED=false
DEMO_ALERT_EMAIL_TO=
DEMO_ALERT_EMAIL_FROM=
DEMO_ALERT_SMTP_HOST=
DEMO_ALERT_SMTP_PORT=587
DEMO_ALERT_SMTP_USERNAME=
DEMO_ALERT_SMTP_PASSWORD=
DEMO_ALERT_SMTP_USE_STARTTLS=true
DEMO_ALERT_SMTP_TIMEOUT_SECONDS=10
DEMO_ALERT_DISK_THRESHOLD_PERCENT=80.0
DEMO_ALERT_DISK_COOLDOWN_HOURS=6
DEMO_ALERT_HEALTH_CONSECUTIVE_FAILURES=3
DEMO_ALERT_HEALTH_COOLDOWN_MINUTES=30
DEMO_ALERT_HEALTH_URL=http://localhost:8001/demo/health

# AssemblyAI usage-rate alert (count-based, independent of the USD caps).
# Email fires when more than THRESHOLD AssemblyAI uses happen within WINDOW_HOURS,
# at most once per COOLDOWN_HOURS. Requires the DEMO_ALERT_* email/SMTP settings
# above to be enabled and configured, otherwise it logs a dry-run.
DEMO_ALERT_ASSEMBLYAI_USAGE_THRESHOLD=5
DEMO_ALERT_ASSEMBLYAI_USAGE_WINDOW_HOURS=24
DEMO_ALERT_ASSEMBLYAI_USAGE_COOLDOWN_HOURS=6
